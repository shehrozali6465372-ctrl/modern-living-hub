# Pinterest OAuth 2.0 credentials
# Get these from https://developers.pinterest.com/apps/
PINTEREST_CLIENT_ID=your_pinterest_app_id_here
PINTEREST_CLIENT_SECRET=your_pinterest_app_secret_here

# Must exactly match the callback URL registered in the Pinterest app settings
# Format: https://YOUR-BACKEND-DOMAIN.com/auth/pinterest/callback
PINTEREST_REDIRECT_URI=https://your-backend-domain.com/auth/pinterest/callback

# Secure random string for session encryption
SESSION_SECRET=generate_a_random_64_char_string_here

# Full deployed frontend base URL including the project path.
# OAuth callbacks redirect to FRONTEND_URL/pinterest.html.
# CORS is derived from the URL origin automatically.
# Example: https://shehrozali6465372-ctrl.github.io/modern-living-hub
FRONTEND_URL=https://shehrozali6465372-ctrl.github.io/modern-living-hub

# Server port (optional, defaults to 3001)
PORT=3001

# Set to "production" in production — enables secure HTTPS cookies + SameSite=None
NODE_ENV=development

# ─── TikTok Content Posting API (optional) ───
# Get these from https://developers.tiktok.com/
# Only needed if TikTok integration is enabled; Pinterest works without these.
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
# Must exactly match the callback URL registered in the TikTok Developer Portal
# Format: https://YOUR-BACKEND-DOMAIN.com/tiktok/auth/callback
TIKTOK_REDIRECT_URI=https://your-backend-domain.com/tiktok/auth/callback

# ─── YouTube Content Posting API (optional) ───
# Get these from https://console.cloud.google.com/
# Only needed if YouTube integration is enabled; Pinterest/TikTok work without these.
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
# Must exactly match the callback URL registered in Google Cloud Console
# Format: https://YOUR-BACKEND-DOMAIN.com/youtube/auth/callback
YOUTUBE_REDIRECT_URI=https://your-backend-domain.com/youtube/auth/callback
